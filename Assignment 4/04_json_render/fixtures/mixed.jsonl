{"op":"add","path":"/elements/kpis","value":{"type":"Row","props":{},"children":["k1","k2"]}}
{"op":"add","path":"/elements/k1","value":{"type":"Metric","props":{"label":"Q3 revenue","value":"$4.20M","delta":"+12%"}}}
{"op":"add","path":"/elements/k2","value":{"type":"Metric","props":{"label":"Top region","value":"West"}}}
{"op":"add","path":"/elements/chart-card","value":{"type":"Card","props":{"title":"Revenue by region (catalog)"},"children":["chart","drill"]}}
