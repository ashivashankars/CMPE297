{"op":"add","path":"/elements/whatif-card","value":{"type":"Card","props":{"title":"Q4 what-if (custom region)"},"children":["whatif"]}}
{"op":"add","path":"/elements/whatif","value":{"type":"HtmlView","props":{"title":"What-if slider","html":{{json:forecast.html}}}}}
