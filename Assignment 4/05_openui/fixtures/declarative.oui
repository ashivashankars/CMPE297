root = Stack([title, kpis, split, actions])
title = Heading("Q3 2026 - revenue up 12%, West leads")
kpis = Stack([revenue, orders, ticket], "row")
revenue = Metric("Revenue", "$4.20M", "+12%")
orders = Metric("Orders", "579,300")
ticket = Metric("Avg ticket", "$7.25")
split = Stack([chartCard, tableCard], "row")
chartCard = Card("Revenue by region", [BarChart("", ["West", "East", "Central", "South"], [1420000, 1180000, 860000, 740000])])
tableCard = Card("Orders by region", [ordersTable, status])
ordersTable = Table(["Region", "Orders"], [["West", 190200], ["East", 161300], ["Central", 122500], ["South", 105300]])
status = Badge("All regions growing", "success")
actions = Stack([Button("West details", "drill_region", {"region": "West"}), Button("Central details", "drill_region", {"region": "Central"})], "row")
