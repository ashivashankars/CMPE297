# Copy to ".env" in this folder:  cp .env.example .env

# --- Option A: Google AI Studio (simplest; free key at https://aistudio.google.com/apikey)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=your-ai-studio-key

# --- Option B: Vertex AI (gcloud auth application-default login)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Models (any Gemini model id your key can use)
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# (b) Gemini CLI agent
GEMINI_CLI_BIN=gemini
GEMINI_CLI_MAX_CALLS=6
GEMINI_CLI_APPROVAL=default          # "yolo" lets the CLI edit/run (sandbox only!)

# (c) Bug assistant - optional integrations
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxx   # enables GitHub's remote MCP server (read-only tools)
# MCP_TOOLBOX_URL=http://127.0.0.1:5000  # use MCP Toolbox for Databases instead of local SQLite MCP

# (e) E-commerce agent
DEMO_USER_EMAIL=alex@example.com
REQUIRE_ORDER_CONFIRMATION=true
